{
  "entity": {
    "binary_sensor": {
      "call_active": {
        "default": "mdi:phone-in-talk"
      },
      "stream_reachable": {
        "default": "mdi:video-off-outline",
        "state": {
          "on": "mdi:video-outline"
        }
      }
    },
    "button": {
      "open": {
        "default": "mdi:door-open"
      }
    },
    "sensor": {
      "sip_status": {
        "default": "mdi:phone-settings-outline",
        "state": {
          "registered": "mdi:phone-check-outline",
          "blocked": "mdi:phone-lock",
          "evicted": "mdi:phone-remove-outline",
          "failed": "mdi:phone-alert-outline",
          "disabled": "mdi:phone-off-outline"
        }
      }
    },
    "switch": {
      "sip": {
        "default": "mdi:phone-off-outline",
        "state": {
          "on": "mdi:phone-outline"
        }
      }
    }
  },
  "services": {
    "open_door": {
      "service": "mdi:door-open"
    },
    "simulate_ring": {
      "service": "mdi:bell-ring-outline"
    },
    "hangup": {
      "service": "mdi:phone-hangup"
    },
    "capture_frame": {
      "service": "mdi:camera-outline"
    }
  }
}
